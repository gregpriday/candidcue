{
  "name": "candidcue",
  "productName": "CandidCue",
  "version": "0.1.0",
  "description": "CandidCue — a desktop interview conductor that puts an animated AI interviewer on a teleprompter.",
  "main": ".vite/build/main.js",
  "author": "Greg Priday <greg@siteorigin.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "electron-forge start",
    "dev": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-sqlite vitest run",
    "test:watch": "NODE_OPTIONS=--experimental-sqlite vitest",
    "test:providers": "NODE_OPTIONS=--experimental-sqlite vitest run --config vitest.providers.config.ts",
    "eval": "tsx tests/evals/run-interview-evals.ts",
    "media:index": "tsx scripts/index-media.ts",
    "media:validate": "tsx scripts/validate-media.ts",
    "prompts:validate": "tsx scripts/validate-prompts.ts",
    "clean:temp": "tsx scripts/clean-temp.ts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run media:validate && npm run prompts:validate"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.1",
    "@fontsource/source-serif-4": "^5.2.9",
    "@uiw/react-codemirror": "^4.25.10",
    "openai": "^4.87.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.6.0",
    "@electron-forge/maker-dmg": "^7.6.0",
    "@electron-forge/maker-squirrel": "^7.6.0",
    "@electron-forge/maker-zip": "^7.6.0",
    "@electron-forge/plugin-vite": "^7.6.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "42.4.1",
    "eslint": "^9.18.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
