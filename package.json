{
  "name": "candidcue",
  "private": true,
  "version": "1.0.0-rc.1",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=26.4.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:vite": "vite",
    "models:fetch": "./scripts/fetch-stt-model.sh",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:dom": "vitest run --config vitest.dom.config.ts",
    "test:all": "vitest run && vitest run --config vitest.dom.config.ts",
    "tauri": "tauri",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "verify:repo": "node scripts/verify-repository.mjs",
    "version:check": "node scripts/version.mjs check",
    "version:set": "node scripts/version.mjs set",
    "version:print": "node scripts/version.mjs print",
    "version:tag": "node scripts/version.mjs tag",
    "notes:check": "node scripts/release-notes.mjs",
    "notices": "node scripts/generate-notices.mjs",
    "notices:check": "node scripts/generate-notices.mjs --check",
    "copyleft:check": "node scripts/verify-no-copyleft-objects.mjs",
    "cargo:test": "cargo test --locked --manifest-path src-tauri/Cargo.toml && cargo test --locked --manifest-path crates/Cargo.toml",
    "cargo:clippy": "cargo clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo clippy --locked --manifest-path crates/Cargo.toml --all-targets -- -D warnings",
    "verify": "pnpm verify:repo && pnpm version:check && pnpm check && pnpm test:all && pnpm cargo:test",
    "release:verify": "node scripts/release-verify.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/highlight": "^1.2.3",
    "@lucide/svelte": "^1.26.0",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.2",
    "@tauri-apps/plugin-opener": "^2.5.1",
    "codemirror": "^6.0.2",
    "hast-util-sanitize": "^5.0.2",
    "mdast-util-to-string": "^4.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tauri-apps/cli": "^2.9.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.1.1",
    "jsdom": "^29.1.1",
    "svelte": "^5.46.2",
    "svelte-check": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  }
}
