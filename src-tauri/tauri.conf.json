{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CandidCue",
  "version": "1.0.0-rc.1",
  "identifier": "com.candidcue.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "control",
        "title": "CandidCue",
        "url": "control.html",
        "width": 1240,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680,
        "visible": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: customprotocol:; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: blob: data:; media-src 'self' asset: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "_comment": [
            "M2. The scope used to be `$APPDATA/scripts/**`, which exposed",
            "EVERY file under every script directory to the asset protocol —",
            "the canonical script.md and the whole revision history included,",
            "not just the media the stage has to render. Only the per-script",
            "assets directory is allowed now.",
            "`deny` takes precedence over `allow` AND over any runtime",
            "`allow_directory` call (tauri::scope::fs::Scope::is_allowed checks",
            "forbidden patterns first), so it is a floor that a future dynamic",
            "widening cannot lift."
          ],
          "allow": [
            "$APPDATA/scripts/*/assets/*"
          ],
          "deny": [
            "$APPDATA/scripts/*/script.md",
            "$APPDATA/scripts/**/*.md",
            "$APPDATA/scripts/*/revisions/**",
            "$APPDATA/candidcue.sqlite3*",
            "$APPDATA/backups/**",
            "$APPDATA/logs/**",
            "$APPDATA/diagnostics/**",
            "$APPDATA/quarantine/**"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "resources": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements/entitlements.macos.plist"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
