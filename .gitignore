# Generated benchmark outputs (fixtures under bench/runs remain tracked — in
# LFS; see .gitattributes)
bench/results/
# Tier-C frame traces. A 60 Hz perceptual trace carries per-token opacity for
# every frame of a take, so one 30-minute run is tens of megabytes and it is
# derived output — regenerable from the tracked fixtures by `cc-bench tier-c`.
# LFS would be the wrong home for a file nothing needs to keep.
bench/traces/

# Claude Code local state. Only the root .claude/ is involved, and only what is
# machine-local inside it: everything else (skills, commands, the Daintree
# assistant's .daintree/assistant/.claude/) is tracked. Un-ignore anything
# below here explicitly if it ever needs to be shared.
/.claude/worktrees/
/.claude/settings.local.json
# Throwaway probe tests written during code review to demonstrate a bug.
tests/unit/probe/
sbom/*
!sbom/native-components.json
dist-release/
provenance/
